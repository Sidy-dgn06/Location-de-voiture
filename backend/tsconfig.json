{
    "compilerOptions": {
        "module": "commonjs",
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "target": "es2020",
        "sourceMap": true,
        "rootDir": "./src",
        "outDir": "./dist",
        "incremental": true,
        "skipLibCheck": true,
        "strict": true,
        "types": ["node"]
    },
    "exclude": ["node_modules", "dist"],
    "include": ["src/**/*.ts"]
}
